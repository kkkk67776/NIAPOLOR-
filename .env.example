# Independent Hosting & Canonical Site URL
VITE_SITE_URL="https://echoxstore.pages.dev"
SITE_URL="https://echoxstore.pages.dev"

# --- External Deployment Variables (Configure in Cloudflare Pages / Render / Vercel, NOT needed in AI Studio Preview) ---
# Cloudflare Pages Edge Runtime (Zero-Sleep Storefront, Checkout, Chat, Orders & Firestore REST):
# Add these encrypted Secrets in Cloudflare Pages -> Settings -> Variables and Secrets:
#   FIREBASE_SERVICE_ACCOUNT_JSON  (same JSON as Render/Vercel so Edge & Node read/write identical Firestore docs)
#   BACKEND_ORIGIN="https://echox-store.onrender.com"   # Or your free Vercel Hobby Node deployment URL (handles Argon2id & WebPush)
#   ECHOX_SECURITY_HMAC_SECRET="SAME_SECRET_ON_CLOUDFLARE_AND_NODE"
#   EDGE_MODE_DISABLED="true"   # Optional emergency rollback switch (routes all /api/* back to BACKEND_ORIGIN)
#
# Security Secrets (Backend / Render / Vercel Environment — auto-synced via Firestore if omitted; requires >= 32 random bytes):
ECHOX_SECURITY_HMAC_SECRET=
# ECHOX_OWNER_EMAIL="abdelkaderbahri570@gmail.com"
# ECHOX_BOOTSTRAP_ACCESS_HASH=""
# ECHOX_BOOTSTRAP_PIN_HASH=""
#
# Optional Immutable Bank Account Lock (Strongly recommended in Render Env Vars so hackers cannot change IBAN even via Admin Panel):
# LOCKED_BANK_IBAN=""
# LOCKED_BANK_HOLDER=""
# LOCKED_BANK_NAME=""
# LOCKED_BANK_SWIFT=""
#
# Persistent Storage Options (Required on Render Free Tier so data & passwords survive restarts):
# Option A (Recommended - connects to existing Firebase Firestore DB in firebase-applet-config.json):
# Paste the raw JSON directly in Render Env UI WITHOUT outer single/double quotes:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"gen-lang-client-0499444627",...}
# (Alternatively set FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or base64-encoded JSON in FIREBASE_SERVICE_ACCOUNT_JSON)
# Option B (Upstash Free Redis REST):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Option C (Render Paid Persistent Disk mount):
# DATA_DIR="/var/data"
#
# Cloudflare R2 Permanent Object Storage for Uploaded Product Images (S3-Compatible):
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""   # Optional custom domain or r2.dev public bucket URL (e.g. https://cdn.echox-store.tn)

