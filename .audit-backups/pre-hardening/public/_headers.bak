/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/owner/*
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/sw-precache.json
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/manifest.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/pwa-*.png
  Cache-Control: public, max-age=3600, must-revalidate

/pwa-*.webp
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon*.png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
